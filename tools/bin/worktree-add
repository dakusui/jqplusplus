#!/bin/bash -eu
#
# ensure-branch-worktree <branch-name>
#
# 1. Checks if the given branch exists locally (can be checked out).
# 2. If it doesn't exist, creates it from the current HEAD.
# 3. Creates a worktree for the branch under {project_root}/worktrees/{branch-name}.
#
# Usage:
#   tools/bin/ensure-branch-worktree feature/my-branch
#

set -eu

message() {
  echo "$@" >&2
}

main() {
  if [[ $# -lt 1 ]]; then
    message "Usage: $0 <branch-name>"
    message "  Ensures the branch exists locally and creates a worktree under worktrees/<branch-name>."
    exit 1
  fi

  local _branch_name="$1"
  local _project_root
  _project_root="$(git rev-parse --show-toplevel)"
  cd "${_project_root}"
  local _worktree_path="${_project_root}/worktrees/${_branch_name}"

  # 1. Check if branch exists locally
  if ! git rev-parse --verify --quiet "${_branch_name}" >/dev/null; then
    message "Branch '${_branch_name}' does not exist. Creating from current HEAD."
    git branch "${_branch_name}"
  fi

  # 2. Create worktree if it doesn't already exist
  if [[ -d "${_worktree_path}" ]]; then
    if [[ -f "${_worktree_path}/.git" ]]; then
      message "Worktree already exists at ${_worktree_path}"
      exit 0
    fi
  fi

  message "Creating worktree at ${_worktree_path}"
  git worktree add "${_worktree_path}" "${_branch_name}"
  message "Done. Worktree at ${_worktree_path}"
}

main "$@"
