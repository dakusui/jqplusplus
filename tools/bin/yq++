#!/usr/bin/env bash
# yq++ — YAML front-end for jq++.
#
# jq++ reads YAML/JSON (resolving $extends and eval: expressions) but emits JSON.
# yq++ wraps it: run jq++, strip private _-prefixed holder keys, emit YAML.
# Relationship:  yq++ : jq++  ::  yq : jq
#
# Usage:    yq++ [jq++ options] [files...]
#           JF_PATH=shared yq++ leaf.yaml++
# Requires: jq++, jq, and a YAML emitter (ruby, or python3 with PyYAML).
set -euo pipefail

_die() { echo "yq++: $*" >&2; exit 1; }
command -v jq++ >/dev/null 2>&1 || _die "jq++ not found on PATH"
command -v jq   >/dev/null 2>&1 || _die "jq not found on PATH"

_to_yaml() {
  if command -v ruby >/dev/null 2>&1; then
    ruby -ryaml -rjson -e 'puts YAML.dump(JSON.parse(STDIN.read))'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys,json,yaml; print(yaml.safe_dump(json.load(sys.stdin), sort_keys=False), end="")'
  else
    _die "need ruby or python3 to emit YAML"
  fi
}

# Recursively drop object keys beginning with "_" (private holder fields).
_strip='def walk(f): . as $in
  | if type=="object" then reduce keys_unsorted[] as $k ({}; . + {($k): ($in[$k]|walk(f))}) | f
    elif type=="array" then map(walk(f)) | f
    else f end;
  walk(if type=="object" then with_entries(select(.key|startswith("_")|not)) else . end)'

# yq++'s job is YAML, so when reading from stdin (no file operands) default
# jq++'s input type to YAML — unless the caller already picked one with
# -t/--input. Scan the operands without disturbing "$@".
_have_files=0
_have_input=0
_prev=""
for _a in "$@"; do
  case "$_a" in
    -t|--input)          _have_input=1 ;;
    -t=*|--input=*)      _have_input=1 ;;
    -h|--help|-v|--version) ;;
    -*) ;;
    *)  [ "$_prev" = "-t" ] || [ "$_prev" = "--input" ] || _have_files=1 ;;
  esac
  _prev="$_a"
done
if [ "$_have_files" -eq 0 ] && [ "$_have_input" -eq 0 ]; then
  set -- --input yaml "$@"
fi

# Run jq++ first and capture its output. With `set -e`, a jq++ failure exits
# here with jq++'s own error on stderr — so we never feed empty/partial output
# into jq and the YAML emitter, which used to bury the real message under a
# JSON parse traceback.
_json="$(jq++ "$@")"
[ -n "$_json" ] || exit 0
printf '%s\n' "$_json" | jq "$_strip" | _to_yaml
