{
  "$extends": [
    "funcs.jq"
  ],
  "ports": {
    "$includes": [
      "ports.json"
    ]
  },
  "urls": {
    "$includes": [
      "urls.json"
    ]
  },
  "$local": {
    "baseService": {
      "databaseUrl": "eval:string:funcs::url_of(\"database\")",
      "databasePort": "eval:number:funcs::port_of(\"database\")"
    }
  },
  "components": {
    "backend": {
      "$extends": [
        "baseService"
      ],
      "type": "backend",
      "url": "eval:string:funcs::url_of(\"backend\")",
      "port": "eval:number:funcs::port_of(\"backend\")"
    },
    "admin": {
      "$extends": [
        "baseService"
      ],
      "type": "admin",
      "url": "eval:string:funcs::url_of(\"admin\")",
      "port": "eval:number:funcs::port_of(\"admin\")"
    },
    "frontend": {
      "$extends": [
        "baseService"
      ],
      "type": "frontend",
      "backendUrl": "eval:string:funcs::url_of(\"backend\")",
      "url": "eval:string:funcs::url_of(\"frontend\")",
      "port": "eval:number:funcs::port_of(\"frontend\")"
    }
  }
}
